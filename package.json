{
  "name": "coffee-pass",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "ios": "react-native run-ios --port 8082",
    "lint": "pnpx @biomejs/biome lint --write",
    "start": "react-native start --reset-cache",
    "check": "pnpx @biomejs/biome check --write",
    "format": "pnpx @biomejs/biome format --write",
    "android": "react-native run-android --port 8082",
    "clean": "rm -rf ios/build ios/Pods android/app/build android/.cxx android/build",
    "purge": "rm -rf node_modules/ pnpm-lock.yaml ios/Podfile.lock && pnpm clean",
    "release": "standard-version"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.19.2",
    "react": "19.1.9",
    "react-native": "0.87.1",
    "react-native-autocomplete-dropdown": "5.1.0",
    "react-native-bootsplash": "7.3.3",
    "react-native-date-picker": "5.0.13",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "5.10.0",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@biomejs/biome": "2.5.14",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/codegen": "0.87.1",
    "@react-native/gradle-plugin": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@types/node": "25.9.8",
    "@types/react": "19.3.0",
    "babel-plugin-module-resolver": "5.0.3",
    "globals": "16.5.0",
    "sharp": "0.35.4",
    "standard-version": "9.5.0",
    "typescript": "5.9.3"
  },
  "standard-version": {
    "preset": "conventionalcommits",
    "releaseCommitMessageFormat": "release: v{{currentTag}}",
    "bumpFiles": [
      "package.json",
      {
        "filename": "android/app/build.gradle",
        "updater": "scripts/gradle-updater.js"
      }
    ]
  }
}
